{
	"name": "portal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typegen": "npx pocketbase-typegen --out ./src/lib/pocketbase-types.ts --env"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.0",
		"pocketbase-typegen": "^1.x.x",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"sass": "^1.93.2",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
	},
	"dependencies": {
		"monaco-editor": "^0.54.0",
		"pocketbase": "^0.26.2",
		"vite-plugin-monaco-editor": "^1.1.0"
	}
}